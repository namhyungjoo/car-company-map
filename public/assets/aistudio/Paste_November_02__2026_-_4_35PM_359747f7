        ? company.clients.some(c => c.toLowerCase().includes(query)) 
        : company.clients.toLowerCase().includes(query);

      return inName || inCategory || inTier || inSub || inTags || inProducts || inClients;
    });
  }, [companies, searchQuery, selectedCategory, selectedSubSector]);

  const displayedCompanies = useMemo(() => {
    return filteredCompanies.slice(0, displayCount);
  }, [filteredCompanies, displayCount]);

  const selectedCompany = useMemo(() => {
    return companies.find(c => c.id === selectedCompanyId) || companies[0];
  }, [companies, selectedCompanyId]);

  const toggleBookmark = (id) => {
    setBookmarks(prev => 
      prev.includes(id) ? prev.filter(bId => bId !== id) : [...prev, id]
    );
  };

  // AI 연관 기업 자동 수집 (Gemini)
  const handleAiExpandSearch = async () => {
    if (!searchQuery.trim()) return;
    
    setIsAiLoading(true);
    setAiSearchLog(`'${searchQuery}' 연관 밸류체인 참여 부품/소재 기업 분석 중...`);

    try {
      const prompt = `자동차/모빌리티 전문 밸류체인 분석가로서 '${searchQuery}' 분야에 실제로 참여하거나 부품/소재/SW를 납품하는 한국 기업 2곳의 상세 정보를 JSON 배열 형식으로 반환해줘.
      반드시 아래 JSON 형식을 엄수해줘:
      [
        {
          "name": "회사명",
          "category": "완성차|1차 부품사|2차 부품사|전장·SW|소재|배터리|자율주행|정비·서비스 중 하나",
          "subSector": "섀시/서스펜션|와이어링/하네스|도어/창문/메커니즘|열관리/HVAC|변속기/파워트레인|차체/프레스/핫스탬핑|시트/내장재|램프/광학|배터리셀/팩|양극재/음극재/소재|차량용 반도체/MCU|차량OS/임베디드SW 중 하나",
          "tier": "예: 1차 섀시 벤더, 2차 금형사, 반도체 팹리스 등",
          "tags": ["키워드1", "키워드2", "${searchQuery}"],
          "description": "차량 부품/기술 공급 방식 2줄 설명",
          "mainProducts": ["주력제품1", "주력제품2"],
          "clients": ["고객사1", "고객사2"],
          "competitors": ["경쟁사1"],
          "suppliers": ["협력사1"],
          "location": "지역",
          "employees": "인원수",
          "avgSalary": "평균연봉",
          "careerUrl": "https://도메인",
          "roles": ["직무1", "직무2"]
        }
      ]`;

      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }],
          generationConfig: { responseMimeType: "application/json" }
        })
      });

      const data = await response.json();
      const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text;
      
      if (rawText) {
        const newComps = JSON.parse(rawText);
        const formatted = newComps.map((c, idx) => ({
          ...c,
          id: `ai-${Date.now()}-${idx}`,
          verified: false
        }));

        setCompanies(prev => [...formatted, ...prev]);
        if (formatted.length > 0) {
          setSelectedCompanyId(formatted[0].id);
        }
        setAiSearchLog(`AI가 '${searchQuery}' 연관 자동차 기업 ${formatted.length}곳을 새로 발굴하여 지도에 연동했습니다.`);
      }
    } catch (error) {
      console.error(error);
      setAiSearchLog("AI 데이터 수집 중 오류가 발생했습니다. 키워드를 다시 입력해 보세요.");
    } finally {
      setIsAiLoading(false);
    }
  };

  const handleAdminSubmit = (e) => {
    e.preventDefault();
    if (!adminFormData.name) return;

    const newCompany = {
      id: `manual-${Date.now()}`,
      name: adminFormData.name,
      category: adminFormData.category,
      subSector: adminFormData.subSector,
      tier: adminFormData.tier || "부품사",
      tags: adminFormData.tags.split(',').map(t => t.trim()).filter(Boolean),
      description: adminFormData.description || "등록된 기업 개요가 없습니다.",
      mainProducts: adminFormData.mainProducts.split(',').map(t => t.trim()).filter(Boolean),
      clients: adminFormData.clients.split(',').map(t => t.trim()).filter(Boolean),
      competitors: adminFormData.competitors.split(',').map(t => t.trim()).filter(Boolean),
      suppliers: adminFormData.suppliers.split(',').map(t => t.trim()).filter(Boolean),
      location: adminFormData.location || "한국",
      employees: "미공개",
      avgSalary: adminFormData.avgSalary || "회사 규정 준수",
      careerUrl: adminFormData.careerUrl || "https://www.kaica.or.kr",
      roles: ["엔지니어", "R&D", "생산기술"],
      verified: true
    };

    setCompanies([newCompany, ...companies]);
    setSelectedCompanyId(newCompany.id);
    setActiveTab("explore");
    setAdminFormData({
      name: "", category: "1차 부품사", subSector: "섀시/서스펜션", tier: "1차 벤더", tags: "", description: "", mainProducts: "", clients: "", competitors: "", suppliers: "", location: "", avgSalary: "", careerUrl: ""
    });
  };

  // 연관 기업 클릭 탐색 핸들러
  const handleNavigateToCompany = (targetName) => {
    const found = companies.find(c => c.name.toLowerCase() === targetName.toLowerCase() || c.name.includes(targetName));
    if (found) {
      setSelectedCompanyId(found.id);
    } else {
      setSearchQuery(targetName);
      setSelectedCategory("전체");
      setSelectedSubSector("전체 세부분야");
    }
  };

  return (
    <div className="flex flex-col h-screen bg-slate-950 text-slate-100 font-sans overflow-hidden">
      
      {/* ---------------- Header ---------------- */}
      <header className="h-16 bg-slate-900 border-b border-slate-800 px-4 md:px-6 flex items-center justify-between shrink-0">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-blue-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-indigo-500/20">
            <Network className="w-6 h-6 text-white" />
          </div>
          <div>
            <h1 className="font-bold text-lg tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
              Mobility Map <span className="text-xs px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">730+ DB 연동</span>
            </h1>
            <p className="text-xs text-slate-400 hidden sm:block">자동차 1대 완성에 참여하는 700여 개 부품·소재·SW 산업 밸류체인</p>
          </div>
        </div>

        {/* Global Search Bar */}
        <div className="flex-1 max-w-md mx-4 relative hidden sm:block">
          <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
          <input
            type="text"
            placeholder="경신, 화신, 성우하이텍, 와이어링, 터보차저, 도어래치..."
            value={searchQuery}
            onChange={(e) => {
              setSearchQuery(e.target.value);
              setDisplayCount(30);
            }}
            className="w-full pl-9 pr-24 py-2 bg-slate-950/80 border border-slate-800 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
          />
          {searchQuery && (
            <button
              onClick={handleAiExpandSearch}
              disabled={isAiLoading}
              className="absolute right-1.5 top-1/2 -translate-y-1/2 px-2.5 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-xs flex items-center gap-1 transition-colors disabled:opacity-50"
            >
              <Sparkles className="w-3 h-3" />
              AI 탐색
            </button>
          )}
        </div>

        {/* Header Action Tabs */}
        <div className="flex items-center gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800">
          <button
            onClick={() => setActiveTab("explore")}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all flex items-center gap-1.5 ${
              activeTab === "explore" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-400 hover:text-slate-200"
            }`}
          >
            <Layers className="w-3.5 h-3.5" />
            기업 탐색
          </button>
          <button
            onClick={() => setActiveTab("network")}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all flex items-center gap-1.5 ${
              activeTab === "network" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-400 hover:text-slate-200"
            }`}
          >
            <Network className="w-3.5 h-3.5" />
            관계망 맵
          </button>
          <button
            onClick={() => setActiveTab("bookmarks")}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all flex items-center gap-1.5 relative ${
              activeTab === "bookmarks" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-400 hover:text-slate-200"
            }`}
          >
            <Bookmark className="w-3.5 h-3.5" />
            관심기업
            {bookmarks.length > 0 && (
              <span className="ml-1 px-1.5 py-0.2 rounded-full bg-cyan-500 text-[10px] text-slate-950 font-bold">
                {bookmarks.length}
              </span>
            )}
          </button>
          <button
            onClick={() => setActiveTab("admin")}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all flex items-center gap-1.5 ${
              activeTab === "admin" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-400 hover:text-slate-200"
            }`}
          >
            <Plus className="w-3.5 h-3.5" />
            DB등록
          </button>
        </div>
      </header>

      {/* Mobile Search & AI Log Alert */}
      <div className="sm:hidden p-2 bg-slate-900 border-b border-slate-800 flex gap-2">
        <div className="relative flex-1">
          <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
          <input
            type="text"
            placeholder="기업명/부품 검색..."
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            className="w-full pl-9 pr-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-200"
          />
        </div>
        {searchQuery && (
          <button
            onClick={handleAiExpandSearch}
            disabled={isAiLoading}
            className="px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs flex items-center gap-1"
          >
            <Sparkles className="w-3 h-3" />
            AI
          </button>
        )}
      </div>

      {aiSearchLog && (
        <div className="bg-cyan-950/60 border-b border-cyan-800/80 px-4 py-1.5 text-xs text-cyan-300 flex items-center justify-between">
          <span className="flex items-center gap-1.5">
            <Sparkles className="w-3.5 h-3.5 text-cyan-400 animate-pulse" />
            {aiSearchLog}
          </span>
          <button onClick={() => setAiSearchLog("")} className="text-cyan-400 hover:text-white">✕</button>
        </div>
      )}

      {/* ---------------- Main Layout ---------------- */}
      <div className="flex-1 flex overflow-hidden">
        
        {/* Left Pane: Filter & Company Cards List */}
        <aside className={`${activeTab === 'explore' || activeTab === 'bookmarks' ? 'flex' : 'hidden md:flex'} w-full md:w-96 border-r border-slate-800 bg-slate-900/50 flex-col shrink-0 overflow-hidden`}>
          
          {/* Main Category Filter Pills */}
          <div className="p-2 border-b border-slate-800 overflow-x-auto no-scrollbar flex items-center gap-1.5 shrink-0 bg-slate-900">
            {CATEGORIES.map(cat => (
              <button
                key={cat}
                onClick={() => {
                  setSelectedCategory(cat);
                  setDisplayCount(30);
                }}
                className={`px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap transition-all ${
                  selectedCategory === cat 
                    ? "bg-indigo-600 text-white shadow-sm" 
                    : "bg-slate-800/80 text-slate-400 hover:bg-slate-800 hover:text-slate-200"
                }`}
              >
                {cat}
              </button>
            ))}
          </div>

          {/* Sub-Sector Filter Pills */}
          <div className="p-2 bg-slate-950/90 border-b border-slate-800 flex items-center gap-1.5 overflow-x-auto no-scrollbar">
            <span className="text-[11px] text-slate-500 font-semibold shrink-0 pl-1">부품분야:</span>
            {SUB_SECTORS.map(sub => (
              <button
                key={sub}
                onClick={() => {
                  setSelectedSubSector(sub);
                  setDisplayCount(30);
                }}
                className={`px-2 py-0.5 rounded text-[11px] whitespace-nowrap transition-colors ${
                  selectedSubSector === sub
                    ? "bg-cyan-500/20 text-cyan-300 border border-cyan-500/40"
                    : "text-slate-400 hover:text-slate-200 bg-slate-900"
                }`}
              >
                {sub}
              </button>
            ))}
          </div>

          {/* List Counter Info */}
          <div className="px-4 py-2 bg-slate-950/40 border-b border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
            <span>
              {activeTab === 'bookmarks' ? '북마크 저장 기업' : '부품조합 DB 탐색'}{' '}
              <strong className="text-cyan-400">
                {activeTab === 'bookmarks' 
                  ? bookmarks.length 
                  : filteredCompanies.length}
              </strong> / 730개
            </span>
            <span className="text-[11px] text-slate-500">KAICA · DART 공시 연동</span>
          </div>

          {/* Company Cards Container */}
          <div className="flex-1 overflow-y-auto p-3 space-y-2.5">
            {activeTab === 'bookmarks' ? (
              // Bookmarks View
              companies.filter(c => bookmarks.includes(c.id)).map(comp => (
                <CompanyListItem 
                  key={comp.id} 
                  comp={comp} 
                  isSelected={comp.id === selectedCompanyId}
                  isBookmarked={true}
                  onSelect={() => setSelectedCompanyId(comp.id)}
                  onToggleBookmark={() => toggleBookmark(comp.id)}
                />
              ))
            ) : displayedCompanies.length === 0 ? (
              <div className="text-center py-12 px-4">
                <Building2 className="w-10 h-10 text-slate-600 mx-auto mb-3 stroke-[1.5]" />
                <p className="text-sm font-medium text-slate-300">검색 조건에 해당 부품사가 없습니다.</p>
                <p className="text-xs text-slate-500 mt-1">상단 AI 탐색 버튼을 누르면 연관 기업을 자동 발굴합니다.</p>
              </div>
            ) : (
              <>
                {displayedCompanies.map(comp => (
                  <CompanyListItem 
                    key={comp.id} 
                    comp={comp} 
                    isSelected={comp.id === selectedCompanyId}
                    isBookmarked={bookmarks.includes(comp.id)}
                    onSelect={() => setSelectedCompanyId(comp.id)}
                    onToggleBookmark={() => toggleBookmark(comp.id)}
                  />
                ))}

                {/* Infinite Scroll / Load More */}
                {filteredCompanies.length > displayCount && (
                  <button
                    onClick={() => setDisplayCount(prev => prev + 40)}
                    className="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-semibold border border-slate-700 transition-colors my-2"
                  >
                    기업 더 불러오기 ({filteredCompanies.length - displayCount}개 남음)
                  </button>
                )}
              </>
            )}
          </div>
        </aside>

        {/* Right Content Pane: Company Detail / Relationship Graph / Admin Form */}
        <main className="flex-1 bg-slate-950 flex flex-col overflow-y-auto">
          
          {activeTab === "admin" ? (
            /* Admin Entry Form */
            <div className="max-w-2xl mx-auto p-6 w-full">
              <div className="mb-6">
                <h2 className="text-xl font-bold text-slate-100 flex items-center gap-2">
                  <Plus className="w-5 h-5 text-indigo-400" />
                  신규 자동차 부품/소재 기업 등록 (어드민)
                </h2>
                <p className="text-xs text-slate-400 mt-1">
                  데이터베이스에 존재하지 않는 1·2차 부품사나 협력사 정보를 직접 수동 등록합니다.
                </p>
              </div>

              <form onSubmit={handleAdminSubmit} className="space-y-4 bg-slate-900/80 p-5 rounded-2xl border border-slate-800">
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">기업명 *</label>
                    <input
                      type="text"
                      required
                      placeholder="예: 경신, 광진상공"
                      value={adminFormData.name}
                      onChange={e => setAdminFormData({...adminFormData, name: e.target.value})}
                      className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-indigo-500"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">산업 분야 *</label>
                    <select
                      value={adminFormData.category}
                      onChange={e => setAdminFormData({...adminFormData, category: e.target.value})}
                      className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-indigo-500"
                    >
                      {CATEGORIES.filter(c => c !== "전체").map(c => (
                        <option key={c} value={c}>{c}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">세부 부품 영역</label>
                    <select
                      value={adminFormData.subSector}
                      onChange={e => setAdminFormData({...adminFormData, subSector: e.target.value})}
                      className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-indigo-500"
                    >
                      {SUB_SECTORS.filter(s => s !== "전체 세부분야").map(s => (
                        <option key={s} value={s}>{s}</option>
                      ))}
                    </select>
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">공급 계층 (Tier)</label>
                    <input
                      type="text"
                      placeholder="예: 현대차 1차 와이어링 벤더"
                      value={adminFormData.tier}
                      onChange={e => setAdminFormData({...adminFormData, tier: e.target.value})}
                      className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-indigo-500"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">기업 개요 및 주요 역량</label>
                  <textarea
                    rows={3}
                    placeholder="부품 정밀 가공 및 차량 밸류체인 참여 내용..."
                    value={adminFormData.description}
                    onChange={e => setAdminFormData({...adminFormData, description: e.target.value})}
                    className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-indigo-500"
                  />
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">주요 납품처 (쉼표 구분)</label>
                    <input
                      type="text"
                      placeholder="현대차, 기아"
                      value={adminFormData.clients}
                      onChange={e => setAdminFormData({...adminFormData, clients: e.target.value})}
                      className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-200"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">경쟁사 (쉼표 구분)</label>
                    <input
                      type="text"
                      placeholder="유라코퍼레이션"
                      value={adminFormData.competitors}
                      onChange={e => setAdminFormData({...adminFormData, competitors: e.target.value})}
                      className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-200"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">협력/소재사 (쉼표 구분)</label>
                    <input
                      type="text"
                      placeholder="LS전선"
                      value={adminFormData.suppliers}
                      onChange={e => setAdminFormData({...adminFormData, suppliers: e.target.value})}
                      className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-200"
                    />
                  </div>
                </div>

                <div className="pt-2">
                  <button
                    type="submit"
                    className="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-semibold shadow-lg shadow-indigo-600/20 transition-colors"
                  >
                    데이터베이스에 입력 저장
                  </button>
                </div>
              </form>
            </div>
          ) : activeTab === "network" ? (
            /* Interactive Network View */
            <div className="p-6 flex-1 flex flex-col">
              <div className="mb-4">
                <h2 className="text-xl font-bold text-slate-100 flex items-center gap-2">
                  <Network className="w-5 h-5 text-cyan-400" />
                  {selectedCompany.name} 생태계 릴레이션 그래프
                </h2>
                <p className="text-xs text-slate-400 mt-1">
                  선택한 기업을 중심으로 완성차 OEM, 1·2차 벤더 및 소재/협력사가 연결된 산업 지도입니다.
                </p>
              </div>

              <div className="flex-1 bg-slate-900/60 border border-slate-800 rounded-2xl p-6 relative flex flex-col justify-between overflow-x-auto min-h-[500px]">
                {/* Visual Graph Layout */}
                <div className="grid grid-cols-3 gap-6 my-auto text-center">
                  
                  {/* Suppliers Column */}
                  <div className="space-y-3">
                    <span className="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">
                      부품 / 소재 / 원자재 협력사
                    </span>
                    {selectedCompany.suppliers && selectedCompany.suppliers.length > 0 ? (
                      selectedCompany.suppliers.map(sup => (
                        <div
                          key={sup}
                          onClick={() => handleNavigateToCompany(sup)}
                          className="p-3 bg-slate-950 border border-slate-800 hover:border-cyan-500/50 rounded-xl cursor-pointer transition-all hover:scale-105"
                        >
                          <p className="text-xs font-semibold text-cyan-300">{sup}</p>
                          <span className="text-[10px] text-slate-500">원자재·하부 파츠</span>
                        </div>
                      ))
                    ) : (
                      <p className="text-xs text-slate-600">등록된 하부 협력사 정보 없음</p>
                    )}
                  </div>

                  {/* Target Company (Center) */}
                  <div className="my-auto">
                    <div className="p-5 bg-gradient-to-b from-indigo-600 to-indigo-900 border-2 border-indigo-400 rounded-2xl shadow-2xl shadow-indigo-500/20 text-white relative">
                      <div className="absolute -top-3 left-1/2 -translate-x-1/2 px-2.5 py-0.5 rounded-full bg-cyan-400 text-slate-950 text-[10px] font-extrabold">
                        {selectedCompany.tier}
                      </div>
                      <h3 className="text-lg font-extrabold mt-1">{selectedCompany.name}</h3>
                      <p className="text-xs text-indigo-200 font-medium mt-1">{selectedCompany.category}</p>
                      <p className="text-[11px] text-indigo-100/70 mt-2 line-clamp-2">{selectedCompany.mainProducts.join(', ')}</p>
                    </div>
                  </div>

                  {/* Clients Column */}
                  <div className="space-y-3">
                    <span className="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">
                      주요 납품처 / 상위 OEM
                    </span>
                    {selectedCompany.clients && selectedCompany.clients.length > 0 ? (
                      (Array.isArray(selectedCompany.clients) ? selectedCompany.clients : [selectedCompany.clients]).map(cli => (
                        <div
                          key={cli}
                          onClick={() => handleNavigateToCompany(cli)}
                          className="p-3 bg-slate-950 border border-slate-800 hover:border-indigo-500/50 rounded-xl cursor-pointer transition-all hover:scale-105"
                        >
                          <p className="text-xs font-semibold text-indigo-300">{cli}</p>
                          <span className="text-[10px] text-slate-500">상위 벤더 & OEM</span>
                        </div>
                      ))
                    ) : (
                      <p className="text-xs text-slate-600">등록된 납품처 정보 없음</p>
                    )}
                  </div>

                </div>

                {/* Competitors Footer Strip */}
                <div className="pt-4 border-t border-slate-800/80">
                  <span className="text-xs font-semibold text-slate-400 mr-2">동일 기술 / 유사 분야 경쟁사:</span>
                  <div className="inline-flex flex-wrap gap-2 mt-2 sm:mt-0">
                    {selectedCompany.competitors && selectedCompany.competitors.map(comp => (
                      <button
                        key={comp}
                        onClick={() => handleNavigateToCompany(comp)}
                        className="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-300 border border-amber-500/20 text-xs hover:bg-amber-500/20 transition-colors"
                      >
                        {comp}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ) : (
            /* Main Company Detail View */
            <div className="p-4 md:p-8 max-w-4xl mx-auto w-full">
              
              {/* Header Banner */}
              <div className="bg-slate-900 p-6 rounded-2xl border border-slate-800 relative overflow-hidden">
                <div className="absolute top-0 right-0 w-64 h-64 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none" />
                
                <div className="flex flex-wrap items-start justify-between gap-4 relative z-10">
                  <div>
                    <div className="flex items-center gap-2">
                      <span className="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                        {selectedCompany.category}
                      </span>
                      <span className="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                        {selectedCompany.tier}
                      </span>
                      {selectedCompany.verified && (
                        <span className="px-2 py-0.5 rounded-full text-[11px] font-medium bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 flex items-center gap-1">
                          <CheckCircle2 className="w-3 h-3" />
                          공시/부품조합 검증
                        </span>
                      )}
                    </div>

                    <h2 className="text-2xl md:text-3xl font-extrabold text-white mt-2">
                      {selectedCompany.name}
                    </h2>
                    
                    <p className="text-xs text-slate-400 mt-1 flex items-center gap-2">
                      <MapPin className="w-3.5 h-3.5 text-slate-500" />
                      {selectedCompany.location}
                    </p>
                  </div>

                  {/* Bookmark Toggle */}
                  <button
                    onClick={() => toggleBookmark(selectedCompany.id)}
                    className={`px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all ${
                      bookmarks.includes(selectedCompany.id)
                        ? "bg-amber-400 text-slate-950 font-bold shadow-lg shadow-amber-400/20"
                        : "bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700"
                    }`}
                  >
                    <Bookmark className="w-4 h-4" fill={bookmarks.includes(selectedCompany.id) ? "currentColor" : "none"} />
                    {bookmarks.includes(selectedCompany.id) ? "북마크 저장됨" : "관심 기업 저장"}
                  </button>
                </div>

                <p className="text-sm text-slate-300 mt-4 leading-relaxed font-normal">
                  {selectedCompany.description}
                </p>

                {/* Quick Info Badges */}
                <div className="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-6 pt-6 border-t border-slate-800/80">
                  <div className="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
                    <span className="text-[11px] text-slate-500 font-medium block">임직원 수</span>
                    <span className="text-sm font-bold text-slate-200 mt-0.5 block">{selectedCompany.employees}</span>
                  </div>
                  <div className="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
                    <span className="text-[11px] text-slate-500 font-medium block">평균 연봉 수준</span>
                    <span className="text-sm font-bold text-cyan-400 mt-0.5 block">{selectedCompany.avgSalary}</span>
                  </div>
                  <div className="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80 col-span-2 sm:col-span-1">
                    <span className="text-[11px] text-slate-500 font-medium block">부품 세부분야</span>
                    <span className="text-sm font-bold text-indigo-300 mt-0.5 block">{selectedCompany.subSector || "모빌리티 부품"}</span>
                  </div>
                </div>
              </div>

              {/* Main Supply Products & Relationship Cards */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                
                {/* Main Products */}
                <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800">
                  <h3 className="text-sm font-bold text-slate-200 flex items-center gap-2 mb-3">
                    <Factory className="w-4 h-4 text-cyan-400" />
                    주력 부품 & 공급 파츠
                  </h3>
                  <div className="space-y-2">
                    {selectedCompany.mainProducts.map((prod, idx) => (
                      <div key={idx} className="p-2.5 bg-slate-950 rounded-xl border border-slate-800 text-xs text-slate-300 flex items-center justify-between">
                        <span>{prod}</span>
                        <span className="text-[10px] text-slate-500">정규 규격</span>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Key Roles Required */}
                <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800">
                  <h3 className="text-sm font-bold text-slate-200 flex items-center gap-2 mb-3">
                    <Briefcase className="w-4 h-4 text-indigo-400" />
                    주요 직무 및 요구 역량
                  </h3>
                  <div className="flex flex-wrap gap-2">
                    {selectedCompany.roles ? selectedCompany.roles.map((role, idx) => (
                      <span key={idx} className="px-3 py-1.5 rounded-lg bg-slate-950 text-xs font-medium text-slate-300 border border-slate-800">
                        {role}
                      </span>
                    )) : (
                      <span className="text-xs text-slate-500">R&D, 정밀가공, 품질보증</span>
                    )}
                  </div>
                </div>

              </div>

              {/* Supply Chain Connection Relational Explorer (Cross Navigation) */}
              <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 mt-6">
                <h3 className="text-sm font-bold text-slate-200 flex items-center gap-2 mb-4">
                  <Share2 className="w-4 h-4 text-amber-400" />
                  연속 기업 탐색망 (클릭 시 해당 기업으로 전환)
                </h3>

                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  
                  {/* Clients */}
                  <div className="bg-slate-950 p-3.5 rounded-xl border border-slate-800">
                    <span className="text-xs font-bold text-indigo-400 block mb-2">주요 고객사 / 납품처</span>
                    <div className="space-y-1.5">
                      {selectedCompany.clients && (Array.isArray(selectedCompany.clients) ? selectedCompany.clients : [selectedCompany.clients]).map(c => (
                        <button
                          key={c}
                          onClick={() => handleNavigateToCompany(c)}
                          className="w-full text-left text-xs font-medium text-slate-300 hover:text-cyan-300 hover:underline flex items-center justify-between py-1"
                        >
                          <span>{c}</span>
                          <ChevronRight className="w-3.5 h-3.5 text-slate-600" />
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* Competitors */}
                  <div className="bg-slate-950 p-3.5 rounded-xl border border-slate-800">
                    <span className="text-xs font-bold text-amber-400 block mb-2">동종 분야 경쟁사</span>
                    <div className="space-y-1.5">
                      {selectedCompany.competitors && selectedCompany.competitors.map(c => (
                        <button
                          key={c}
                          onClick={() => handleNavigateToCompany(c)}
                          className="w-full text-left text-xs font-medium text-slate-300 hover:text-amber-300 hover:underline flex items-center justify-between py-1"
                        >
                          <span>{c}</span>
                          <ChevronRight className="w-3.5 h-3.5 text-slate-600" />
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* Suppliers */}
                  <div className="bg-slate-950 p-3.5 rounded-xl border border-slate-800">
                    <span className="text-xs font-bold text-cyan-400 block mb-2">원자재 / 하부 협력사</span>
                    <div className="space-y-1.5">
                      {selectedCompany.suppliers && selectedCompany.suppliers.map(s => (
                        <button
                          key={s}
                          onClick={() => handleNavigateToCompany(s)}
                          className="w-full text-left text-xs font-medium text-slate-300 hover:text-cyan-300 hover:underline flex items-center justify-between py-1"
                        >
                          <span>{s}</span>
                          <ChevronRight className="w-3.5 h-3.5 text-slate-600" />
                        </button>
                      ))}
                    </div>
                  </div>

                </div>
              </div>

              {/* Recruitment & Portal Job Search Links */}
              <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 mt-6 mb-8">
                <h3 className="text-sm font-bold text-slate-200 flex items-center gap-2 mb-3">
                  <ExternalLink className="w-4 h-4 text-cyan-400" />
                  채용 공고 & 중소·중견 기업 정보 바로가기
                </h3>

                <div className="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                  <a
                    href={selectedCompany.careerUrl}
                    target="_blank"
                    rel="noreferrer"
                    className="p-3 bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/40 rounded-xl text-center text-xs font-semibold text-indigo-300 transition-colors"
                  >
                    공식 채용 페이지
                  </a>
                  <a
                    href={`https://www.saramin.co.kr/zf_user/search/company?searchword=${encodeURIComponent(selectedCompany.name)}`}
                    target="_blank"
                    rel="noreferrer"
                    className="p-3 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-xl text-center text-xs font-medium text-slate-300 transition-colors"
                  >
                    사람인 기업정보
                  </a>
                  <a
                    href={`https://www.jobkorea.co.kr/Search/?stk=${encodeURIComponent(selectedCompany.name)}`}
                    target="_blank"
                    rel="noreferrer"
                    className="p-3 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-xl text-center text-xs font-medium text-slate-300 transition-colors"
                  >
                    잡코리아 채용
                  </a>
                  <a
                    href={`https://www.worknet.go.kr/empInfo/empInfoSrch/list/dtlEmpSrchList.do?keyword=${encodeURIComponent(selectedCompany.name)}`}
                    target="_blank"
                    rel="noreferrer"
                    className="p-3 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-xl text-center text-xs font-medium text-slate-300 transition-colors"
                  >
                    워크넷 강소기업
                  </a>
                </div>
              </div>

            </div>
          )}
        </main>

      </div>
    </div>
  );
}

// ----------------------------------------------------
// Reusable Sub-Component: Company Item Card in Left List
// ----------------------------------------------------
function CompanyListItem({ comp, isSelected, isBookmarked, onSelect, onToggleBookmark }) {
  return (
    <div
      onClick={onSelect}
      className={`p-3.5 rounded-xl border transition-all cursor-pointer relative group ${
        isSelected 
          ? "bg-slate-800/90 border-indigo-500 shadow-lg shadow-indigo-500/10" 
          : "bg-slate-900/60 border-slate-800/80 hover:bg-slate-800/50 hover:border-slate-700"
      }`}
    >
      <div className="flex items-start justify-between gap-2">
        <div>
          <div className="flex items-center gap-2">
            <h3 className="font-semibold text-sm text-slate-100 group-hover:text-indigo-400 transition-colors">
              {comp.name}
            </h3>
            {comp.verified && (
              <CheckCircle2 className="w-3.5 h-3.5 text-cyan-400 inline shrink-0" title="KAICA 및 DART 공시 검증 완료" />
            )}
          </div>
          <p className="text-xs text-indigo-400 font-medium mt-0.5">
            {comp.category} · <span className="text-slate-400">{comp.tier}</span>
          </p>
        </div>

        <button
          onClick={(e) => {
            e.stopPropagation();
            onToggleBookmark();
          }}
          className={`p-1.5 rounded-lg transition-colors ${
            isBookmarked 
              ? "text-amber-400 bg-amber-400/10" 
              : "text-slate-500 hover:text-slate-300 hover:bg-slate-800"
          }`}
        >
          <Bookmark className="w-4 h-4" fill={isBookmarked ? "currentColor" : "none"} />
        </button>
      </div>

      <p className="text-xs text-slate-400 line-clamp-2 mt-2 leading-relaxed">
        {comp.description}
      </p>

      {/* Tag Badges */}
      <div className="flex flex-wrap gap-1 mt-3">
        <span className="text-[10px] px-2 py-0.5 rounded-md bg-cyan-950 text-cyan-300 border border-cyan-800/60 font-medium">
          {comp.subSector || "모빌리티 파츠"}
        </span>
        {comp.tags && comp.tags.slice(0, 2).map(tag => (
          <span key={tag} className="text-[10px] px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 border border-slate-700/50">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  );
}